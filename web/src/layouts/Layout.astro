---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppButton';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	image?: string;
}

const { 
	title, 
	description = 'CortiGlow - Catálogo de toda clase de cortinas, persianas e iluminación. Envío gratis en Colombia, garantía 100%, instalación incluida. Contacto directo por WhatsApp.',
	keywords = 'iluminación, cortinas, persianas, lámparas, lámparas LED, cortinas modernas, persianas enrollables, iluminación hogar, cortinas blackout, CortiGlow, Colombia',
	image = '/og-image.jpg'
} = Astro.props;

const siteUrl = Astro.site || 'http://localhost:4321';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<!-- SEO Básico -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content="index, follow" />
		<meta name="author" content="CortiGlow" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:site_name" content="CortiGlow" />
		<meta property="og:locale" content="es_ES" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		
		<!-- WhatsApp Preview -->
		<meta property="og:phone_number" content="+573229468431" />
		
		<!-- Geo Tags - Colombia -->
		<meta name="geo.region" content="CO" />
		<meta name="geo.placename" content="Colombia" />
		<meta name="geo.position" content="4.570868;-74.297333" /> <!-- Bogotá -->
		<meta name="ICBM" content="4.570868, -74.297333" />
		<meta name="DC.title" content="CortiGlow - Iluminación y Cortinas en Colombia" />
		
		<!-- Icons -->
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="apple-touch-icon" href="/logo.png" />
		
		<!-- Generator -->
		<meta name="generator" content={Astro.generator} />
		
		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

		
		<!-- Schema.org JSON-LD - Colombia -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "Store",
			"name": "CortiGlow",
			"description": "Tienda de iluminación LED y cortinas modernas en Colombia. Envíos a todo el país.",
			"url": "https://cortiglow.com",
			"telephone": "+573229468431",
			"email": "info@cortiglow.com",
			"address": {
				"@type": "PostalAddress",
				"addressCountry": "CO",
				"addressLocality": "Colombia",
				"addressRegion": "Nacional"
			},
			"geo": {
				"@type": "GeoCoordinates",
				"latitude": "4.570868",
				"longitude": "-74.297333"
			},
			"priceRange": "$$",
			"priceCurrency": "COP",
			"areaServed": {
				"@type": "Country",
				"name": "Colombia"
			},
			"availableLanguage": "es-CO",
			"paymentAccepted": ["Cash", "Credit Card", "Nequi", "Daviplata", "Bancolombia", "PSE"],
			"openingHours": "Mo-Sa 08:00-18:00",
			"currenciesAccepted": "COP"
		}
		</script>
		
		<style>
			body {
				font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
			}
			h1, h2, h3, h4, h5, h6 {
				font-family: 'Outfit', sans-serif;
			}
