		</header>

		<!-- Main Content -->
		<main class="flex-grow pt-20"> <!-- Added pt-20 because header is fixed -->
			<slot />
		</main>

		<!-- Floating WhatsApp Button -->
		<WhatsAppButton client:only="react" />

