---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import ProductGrid from '../components/ProductGrid';
import { ProductService } from '../services/product.service';

const pageTitle = 'CortiGlow | La Luz y Sombra que Transforman tu Espacio';
const pageDescription = 'Descubre lo mejor en toda clase de cortinas, persianas e iluminación premium en Colombia. Envío gratis, garantía 100%. Paga con Nequi, Daviplata, PSE. WhatsApp +57 322 946 8431';
const pageKeywords = 'iluminación Colombia, lámparas Bogotá, persianas modernas Medellín, cortinas blackout Cali, iluminación hogar Colombia, comprar cortinas Colombia, persianas roller Barranquilla, tienda decoración Colombia';

// Fetch products at build time for SSR
const products = await ProductService.getProducts();
---

<Layout 
	title={pageTitle}
	description={pageDescription}
	keywords={pageKeywords}
>
	<!-- NEW HERO SECTION INMERSIVO -->
	<section class="relative min-h-[85vh] flex flex-col items-center justify-between overflow-hidden bg-trueblack-900 pt-32 pb-8">
		<!-- Background Elements (Luces y gradientes) -->
		<div class="absolute inset-0 z-0">
			<!-- Gradiente de fondo -->
			<div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-gold-900/40 via-trueblack-900 to-trueblack-900"></div>
			<!-- Rejilla sutil -->
			<div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
			<!-- Esfera luminosa animada (Iluminación simulada) -->
			<div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-gold-500/20 rounded-full blur-[120px] mix-blend-screen animate-pulse pointer-events-none"></div>
		</div>

		<!-- Main Content Wrapper (Centers vertically) -->
		<div class="relative z-10 w-full flex-grow flex flex-col justify-center items-center max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center pb-12 mt-auto">
			<div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-md mb-8 animate-float">
				<span class="flex h-2 w-2 relative">
					<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-gold-400 opacity-75"></span>
					<span class="relative inline-flex rounded-full h-2 w-2 bg-gold-500"></span>
				</span>
				<span class="text-sm font-medium text-gray-300 tracking-wide uppercase">Nueva Colección 2026</span>
			</div>

			<h1 class="font-heading text-5xl md:text-7xl lg:text-8xl font-black text-white leading-tight tracking-tight mb-6 mt-4">
				El Toque de <br/>
				<span class="bg-gradient-to-r from-gold-300 via-gold-400 to-gold-600 bg-clip-text text-transparent drop-shadow-[0_0_30px_rgba(212,175,55,0.4)]">
					Elegancia
				</span>
				<br/> Para Tu Hogar
			</h1>

			<p class="mt-4 max-w-2xl text-lg md:text-xl text-gray-400 font-light mx-auto mb-10 leading-relaxed">
				Descubre nuestra selección premium de cortinas, persianas e iluminación. 
				Diseños de vanguardia que combinan tecnología, confort y estilo absoluto.
			</p>

			<div class="flex flex-col sm:flex-row gap-5 justify-center w-full sm:w-auto">
				<a href="#catalogo" class="px-8 py-4 bg-gradient-to-r from-gold-400 to-gold-600 text-trueblack-900 rounded-full font-bold text-lg hover:from-gold-300 hover:to-gold-500 transition-all shadow-[0_0_20px_rgba(212,175,55,0.4)] hover:shadow-[0_0_30px_rgba(212,175,55,0.6)] transform hover:-translate-y-1">
					Explorar Catálogo
				</a>
				<a href="https://wa.me/573229468431?text=Hola,%20quiero%20una%20asesor%C3%ADa%20gratuita" target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-white/5 backdrop-blur-md text-white border border-white/10 rounded-full font-bold text-lg hover:bg-white/10 transition-all">
					Asesoría Gratuita
				</a>
			</div>
		</div>
		
		<!-- Scroll indicator -->
		<a href="#catalogo" aria-label="Desplazarse al catálogo" class="relative z-20 flex flex-col items-center gap-2 animate-bounce opacity-50 hover:opacity-100 transition-opacity mt-auto cursor-pointer pb-2">
			<span class="text-xs text-gray-400 uppercase tracking-widest hidden sm:block">Descubrir</span>
			<svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
		</a>
	</section>

	<!-- Catálogo de Productos -->
    <section id="catalogo" class="py-24 bg-trueblack-900/95 relative z-10 border-t border-white/5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-16 border-b border-white/5 pb-8 relative">
			<!-- Glow sutil del titular -->
			<div class="absolute -top-10 -left-10 w-40 h-40 bg-gold-600/10 rounded-full blur-[50px] pointer-events-none"></div>

            <div class="relative z-10">
              <h2 class="text-3xl md:text-5xl font-heading font-bold text-white mb-2">
                Colecciones <span class="bg-gradient-to-r from-gold-400 to-gold-600 bg-clip-text text-transparent">Destacadas</span>
              </h2>
              <p class="text-gray-400 font-light mt-3">
                Piezas exclusivas listas para elevar el diseño de tus ambientes.
              </p>
            </div>
            <div class="flex gap-3 mt-6 md:mt-0 relative z-10">
              <a
                href="/categoria/iluminacion"
                class="px-5 py-2.5 bg-trueblack-800 text-gray-300 rounded-full hover:bg-trueblack-700 hover:text-white transition-colors text-sm font-medium border border-white/5"
                data-astro-prefetch
              >
                Iluminación
              </a>
              <a
                href="/categoria/cortinas"
                class="px-5 py-2.5 bg-trueblack-800 text-gray-300 rounded-full hover:bg-trueblack-700 hover:text-white transition-colors text-sm font-medium border border-white/5"
                data-astro-prefetch
              >
                Cortinas y Persianas
              </a>
            </div>
          </div>

          <ProductGrid client:load initialProducts={products} />
        </div>
    </section>

	<!-- Nueva Sección Bento Box de Features -->
	<section class="py-24 bg-trueblack-900 relative">
		<!-- Sutil gradiente para separar seccion -->
		<div class="absolute inset-0 bg-gradient-to-b from-trueblack-900/95 via-trueblack-800 to-trueblack-900 pointer-events-none z-0"></div>
		
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
			<div class="text-center mb-16 relative">
				<!-- Light sutil central -->
				<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-32 bg-gold-600/10 rounded-[100%] blur-[60px] pointer-events-none"></div>

				<h2 class="text-sm font-bold tracking-widest text-gold-500 uppercase mb-3 relative z-10">La Experiencia CortiGlow</h2>
				<h3 class="text-3xl md:text-5xl font-heading font-bold text-white relative z-10">Lujo en cada detalle</h3>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Bento 1 - Feature Principal -->
				<div class="md:col-span-2 bg-gradient-to-br from-[#1a1a1a] to-[#0a0a0a] rounded-[2rem] p-8 md:p-12 flex flex-col justify-between overflow-hidden relative group border border-white/5 hover:border-gold-500/30 transition-all duration-500 hover:shadow-[0_0_30px_rgba(212,175,55,0.05)]">
					<div class="absolute top-0 right-0 w-64 h-64 bg-gold-500/10 rounded-full blur-[80px] group-hover:bg-gold-500/20 transition-all duration-500 pointer-events-none text-trueblack-900 text-transparent"></div>
					<div class="relative z-10">
						<div class="w-14 h-14 bg-white/5 backdrop-blur-md rounded-2xl flex items-center justify-center border border-white/10 mb-8 shadow-lg">
							<svg class="w-7 h-7 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
						</div>
						<h4 class="text-2xl md:text-3xl font-heading font-bold text-white mb-4">Estética y Funcionalidad</h4>
						<p class="text-gray-400 font-light leading-relaxed max-w-md">Cada pieza de nuestro catálogo ha sido seleccionada meticulosamente para fusionar confort acústico, control térmico, iluminación precisa y estética superior.</p>
					</div>
				</div>

				<!-- Bento 2 -->
				<div class="bg-gradient-to-b from-[#1a1a1a] to-[#0a0a0a] rounded-[2rem] p-8 flex flex-col relative group border border-white/5 hover:border-gold-500/30 transition-all duration-500 hover:shadow-[0_0_30px_rgba(212,175,55,0.05)]">
					<div class="w-12 h-12 bg-white/5 backdrop-blur-md rounded-2xl flex items-center justify-center border border-white/10 mb-6 relative z-10">
						<svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
					</div>
					<h4 class="text-xl font-heading font-bold text-white mb-3 relative z-10">Respaldo Total</h4>
					<p class="text-gray-400 text-sm font-light leading-relaxed relative z-10">Tu inversión está protegida. Ofrecemos respaldo total y cambios inmediatos ante cualquier defecto de fábrica.</p>
				</div>

				<!-- Bento 3 -->
				<div class="bg-gradient-to-t from-[#1a1a1a] to-[#0a0a0a] rounded-[2rem] p-8 flex flex-col relative group border border-white/5 hover:border-gold-500/30 transition-all duration-500 hover:shadow-[0_0_30px_rgba(212,175,55,0.05)]">
					<div class="w-12 h-12 bg-white/5 backdrop-blur-md rounded-2xl flex items-center justify-center border border-white/10 mb-6 relative z-10">
						<svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
					</div>
					<h4 class="text-xl font-heading font-bold text-white mb-3 relative z-10">Envíos Seguros</h4>
					<p class="text-gray-400 text-sm font-light leading-relaxed relative z-10">Llegamos a cada rincón del país con empaques especializados que garantizan la integridad de tus productos.</p>
				</div>

				<!-- Bento 4 -->
				<div class="md:col-span-2 bg-[#0c0c0c] rounded-[2rem] p-8 md:p-12 flex items-center justify-between overflow-hidden relative group border border-white/5 hover:border-gold-500/30 transition-all duration-500 hover:shadow-[0_0_30px_rgba(212,175,55,0.05)]">
					<!-- Pattern decorativo -->
					<div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PGNpcmNsZSBjeD0iMiIgY3k9IjIiIHI9IjEiIGZpbGw9InJnYmEoMjEyLCAxNzUsIDU1LCAwLjE1KSIvPjwvc3ZnPg==')] opacity-50 z-0"></div>
					
					<div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between w-full gap-8">
						<div>
							<h4 class="text-2xl font-heading font-bold text-white mb-2">Instalación Profesional</h4>
							<p class="text-gray-400 font-light max-w-lg">Despreocúpate. Nuestro equipo técnico dejará todo perfectamente instalado y configurado en tu hogar u oficina.</p>
						</div>
						<a href="https://wa.me/573229468431?text=Hola,%20quiero%20agendar%20una%20cita" target="_blank" rel="noopener noreferrer" class="shrink-0 px-8 py-3 bg-white text-trueblack-900 rounded-full font-bold hover:bg-gray-200 transition-colors">Agendar Cita</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section Premium -->
	<section class="py-32 relative overflow-hidden bg-trueblack-900 border-t border-white/5">
		<!-- Light flare env -->
		<div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom,_var(--tw-gradient-stops))] from-gold-900/20 via-trueblack-900 to-trueblack-900 z-0"></div>

		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
			<h2 class="text-4xl md:text-6xl font-heading font-black mb-6 text-white">Transforma tus <span class="bg-gradient-to-r from-gold-300 to-gold-600 bg-clip-text text-transparent">espacios hoy mismo</span></h2>
			<p class="text-xl text-gray-400 mb-12 font-light max-w-2xl mx-auto">
				Recibe asesoría personalizada sin costo. Nuestros expertos te guiarán para encontrar la configuración perfecta de luz y sombra para tu hogar.
			</p>
			
			<div class="flex flex-col sm:flex-row gap-5 justify-center mt-8">
				<a 
					href="https://wa.me/573229468431" 
					target="_blank"
					class="px-8 py-5 bg-gradient-to-r from-[#25D366] to-[#128C7E] text-white rounded-full font-bold text-lg shadow-[0_0_15px_rgba(37,211,102,0.2)] hover:shadow-[0_0_25px_rgba(37,211,102,0.4)] transition-all transform hover:-translate-y-1 flex items-center justify-center gap-3 w-full sm:w-auto"
				>
					<svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
						<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
					</svg>
					Contactar a un Asesor
				</a>
			</div>
		</div>
	</section>
</Layout>
