---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { formatCOP } from '../../utils/currency';
import { ProductService } from '../../services/product.service';
import { CategoryService } from '../../services/category.service';

export async function getStaticPaths() {
  const products = await ProductService.getProducts();
  return products.map((product: any) => ({
    params: { id: product.id },
  }));
}

const { id } = Astro.params;
if (!id) return Astro.redirect('/404');

let product: any = null;
let error = false;

try {
  const products = await ProductService.getProducts();
  product = products.find((p: any) => p.id === id);
  if (!product) error = true;
  
  if (product && product.category_id) {
     const categories = await CategoryService.getCategories();
     const cat = categories.find((c: any) => c.id === product.category_id);
     product.category = cat;

     let currentCat = cat;
     while (currentCat && currentCat.parent_id) {
       currentCat = categories.find((c: any) => c.id === currentCat.parent_id);
     }
     
     if (currentCat && currentCat.slug === 'cortinas') {
       product.warrantyYears = 3;
       product.warrantyException = "No cubre mal manejo ni daños por uso indebido.";
     } else {
       product.warrantyYears = 1;
       product.warrantyException = "No cubre picos de voltaje ni malas instalaciones eléctricas.";
     }
  }
} catch (e) {
  error = true;
}

if (error || !product) return Astro.redirect('/404');

const formattedPrice = formatCOP(product.price);
const whatsappNumber = '+573229468431';
const whatsappMessage = `Hola, estoy interesado en ${product.name} (${formattedPrice})`;

const pageTitle = `${product.name} - ${formattedPrice} | CortiGlow Colombia`;
const pageDescription = product.description 
	? `${product.description.substring(0, 150)}... ✨ Envío gratis a toda Colombia ✨ Garantía 100% ✨ Precio: ${formattedPrice}. Paga con Nequi, Daviplata, PSE. WhatsApp +57 322 946 8431` 
	: `${product.name} - Precio: ${formattedPrice}. Envío gratis a toda Colombia y garantía 100%. Contacto directo por WhatsApp +57 322 946 8431`;
const pageImage = product.images?.[0] || '/og-image.jpg';
const pageKeywords = `${product.name}, ${product.category?.name || 'productos'}, comprar ${product.name} Colombia, precio ${product.name} Colombia, ${product.name} Bogotá, ${product.name} Medellín`;

// Schema.org Product JSON-LD - Colombia
const productSchema = {
	"@context": "https://schema.org",
	"@type": "Product",
	"name": product.name,
	"description": product.description || product.name,
	"image": product.images || [],
	"brand": {
		"@type": "Brand",
		"name": "CortiGlow"
	},
	"offers": {
		"@type": "Offer",
		"url": `https://cortiglow.com/producto/${product.id}`,
		"priceCurrency": "COP",
		"price": product.price,
		"availability": "https://schema.org/InStock",
		"seller": {
			"@type": "Organization",
			"name": "CortiGlow Colombia"
		},
		"areaServed": {
			"@type": "Country",
			"name": "Colombia"
		},
		"availableDeliveryMethod": "https://schema.org/OnSitePickup",
		"priceValidUntil": new Date(new Date().getFullYear() + 1, 11, 31).toISOString().split('T')[0]
	},
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "4.8",
		"reviewCount": "47"
	}
};
---

<Layout 
	title={pageTitle}
	description={pageDescription}
	keywords={pageKeywords}
	image={pageImage}
>
	<!-- Product Schema -->
	<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <!-- Breadcrumb -->
  <div class="bg-trueblack-900 border-b border-white/10 relative z-20 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center space-x-2 text-sm">
        <a href="/" class="text-gray-400 hover:text-gold-500 transition-colors">Inicio</a>
        <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        {product.category && (
          <>
            <a href={`/categoria/${product.category.slug || product.category.name.toLowerCase()}`} class="text-gray-400 hover:text-gold-500 transition-colors">
              {product.category.name}
            </a>
            <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </>
        )}
        <span class="text-gold-400 font-medium">{product.name}</span>
      </nav>
    </div>
  </div>

  <!-- Product Details -->
  <div class="bg-trueblack-900 min-h-screen relative overflow-hidden pb-20 pt-8">
    <!-- Ambient Background Lighting -->
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-gradient-radial from-gold-500/10 to-transparent opacity-50 blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[800px] h-[800px] bg-gradient-radial from-white/5 to-transparent opacity-50 blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- Image Gallery -->
        <div class="space-y-6">
          <!-- Main Image -->
          <div class="aspect-[4/5] bg-trueblack-800 rounded-[2rem] overflow-hidden border border-white/5 shadow-[0_0_40px_rgba(0,0,0,0.5)] relative group">
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
            <img 
              id="main-product-image"
              src={product.images?.[0] || 'https://via.placeholder.com/800'} 
              alt={product.name}
              class="w-full h-full object-cover transition-all duration-300 group-hover:scale-105"
              style={`view-transition-name: img-${product.id}`}
              loading="eager" 
            />
          </div>

          <!-- Thumbnail Gallery -->
          {product.images && product.images.length > 1 && (
            <div class="grid grid-cols-4 gap-4" id="thumbnail-gallery">
              {product.images.map((img: string, index: number) => (
                <button 
                  type="button"
                  data-img={img}
                  class={`thumbnail-btn aspect-square rounded-2xl overflow-hidden border-2 hover:border-gold-500 transition-all ${index === 0 ? 'border-gold-500 shadow-[0_0_15px_rgba(212,175,55,0.3)] active-thumb opacity-100' : 'border-white/5 opacity-70 hover:opacity-100'}`}
                >
                  <img 
                    src={img} 
                    alt={`Vista ${index + 1} de ${product.name}`}
                    class="w-full h-full object-cover hover:scale-110 transition-transform duration-300 pointer-events-none" 
                  />
                </button>
              ))}
            </div>
          )}

          <!-- Features -->
          <div class="bg-gradient-to-br from-[#1a1a1a] to-[#0a0a0a] rounded-2xl p-8 border border-white/5 shadow-xl">
            <h3 class="text-xl font-heading font-semibold text-white mb-6 flex items-center gap-3">
              <svg class="w-6 h-6 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
              Garantía Premium
            </h3>
            <ul class="space-y-4">
              <li class="flex items-start text-gray-300">
                <div class="w-8 h-8 rounded-full bg-gold-500/10 flex items-center justify-center mr-4 shrink-0 mt-1">
                  <svg class="w-4 h-4 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </div>
                <div>
                  <span class="block">Garantía oficial de {product.warrantyYears} {product.warrantyYears === 1 ? 'año' : 'años'}</span>
                  <span class="block text-xs text-gray-500 mt-1 font-light italic">* {product.warrantyException}</span>
                </div>
              </li>
              <li class="flex items-center text-gray-300">
                <div class="w-8 h-8 rounded-full bg-gold-500/10 flex items-center justify-center mr-4">
                  <svg class="w-4 h-4 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </div>
                Envío seguro a todo el país
              </li>
              <li class="flex items-center text-gray-300">
                <div class="w-8 h-8 rounded-full bg-gold-500/10 flex items-center justify-center mr-4">
                  <svg class="w-4 h-4 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </div>
                Asesoría de instalación premium
              </li>
            </ul>
          </div>
        </div>

        <!-- Product Info -->
        <div class="space-y-8 flex flex-col justify-center">
          <!-- Category Badge -->
          {product.category && (
            <div>
              <span class="inline-block px-4 py-1.5 bg-black/40 backdrop-blur-md text-gold-400 text-xs font-medium tracking-widest uppercase rounded-full border border-gold-500/30 shadow-lg">
                {product.category.name}
              </span>
            </div>
          )}

          <!-- Title -->
          <h1 class="text-4xl lg:text-6xl font-heading font-bold text-white leading-tight">
            {product.name}
          </h1>

          <!-- Divider -->
          <div class="w-16 h-1 bg-gradient-to-r from-gold-500 to-gold-300 rounded-full"></div>

          <!-- Rating -->
          <div class="flex items-center space-x-3">
            <div class="flex space-x-1">
              {[...Array(5)].map((_, i) => (
                <svg key={i} class="w-5 h-5 text-gold-500 fill-current drop-shadow-[0_0_5px_rgba(212,175,55,0.5)]" viewBox="0 0 20 20">
                  <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                </svg>
              ))}
            </div>
            <span class="text-gray-400 text-sm font-light">(47 reseñas verificadas)</span>
          </div>

          <!-- Price -->
          <div class="bg-gradient-to-br from-[#1a1a1a] to-[#0a0a0a] rounded-[2rem] p-8 border border-white/5 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-gold-500/5 rounded-full blur-2xl"></div>
            <div class="flex items-baseline justify-between relative z-10">
              <div>
                <span class="block text-sm text-gray-400 font-medium mb-2 uppercase tracking-wider">Precio en Colombia</span>
                <div class="text-5xl font-heading font-black bg-gradient-to-r from-gold-300 to-gold-500 bg-clip-text text-transparent drop-shadow-[0_0_15px_rgba(212,175,55,0.2)]">
                  {formattedPrice}
                </div>
              </div>
              <div class="text-right">
                <span class="inline-flex items-center gap-2 px-4 py-2 bg-green-500/10 text-green-400 text-xs font-bold uppercase tracking-wider rounded-full border border-green-500/20 shadow-[0_0_15px_rgba(34,197,94,0.1)]">
                  <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
                  En stock
                </span>
              </div>
            </div>
          </div>

          <!-- Description -->
          {product.description && (
            <div class="prose prose-invert max-w-none">
              <h2 class="text-2xl font-heading font-semibold text-white mb-4">Descripción</h2>
              <p class="text-gray-300 leading-relaxed font-light text-lg">{product.description}</p>
            </div>
          )}

          <!-- Actions -->
          <div class="space-y-6 pt-4">
            <!-- Contact Button -->
            <a 
              href={`https://wa.me/${whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(whatsappMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full bg-gradient-to-r from-[#25D366] to-[#128C7E] text-white py-5 rounded-2xl font-bold text-xl shadow-[0_0_20px_rgba(37,211,102,0.3)] hover:shadow-[0_0_30px_rgba(37,211,102,0.5)] transition-all transform hover:scale-[1.02] active:scale-95 flex items-center justify-center space-x-3 group"
            >
              <svg class="w-7 h-7 transform group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <span>Consultar por WhatsApp</span>
            </a>
          </div>

          <!-- Video (if available) -->
          {product.video_url && (
            <div class="rounded-2xl overflow-hidden border border-white/10 shadow-[0_0_30px_rgba(0,0,0,0.5)] mt-8">
              <video controls class="w-full" loading="lazy">
                <source src={product.video_url} type="video/mp4" />
              </video>
            </div>
          )}

          <!-- Shipping Info -->
          <div class="bg-gradient-to-r from-trueblack-800 to-trueblack-900 rounded-2xl p-6 border border-white/5 shadow-inner mt-8">
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-trueblack-900 rounded-full border border-white/10 flex items-center justify-center shadow-lg">
                  <svg class="w-6 h-6 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
                  </svg>
                </div>
              </div>
              <div>
                <h3 class="text-lg font-heading font-semibold text-white mb-1">Envío Premium</h3>
                <p class="text-gray-400 text-sm">Empaque de alta seguridad. Instalación profesional disponible bajo solicitud.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Related Products Section -->
  <div class="bg-trueblack-900 border-t border-white/5 py-24 relative overflow-hidden">
    <!-- Ambient glow -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-64 bg-gold-500/5 blur-3xl pointer-events-none"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-white mb-4">Piezas Complementarias</h2>
      <div class="w-24 h-1 bg-gradient-to-r from-gold-500 to-gold-300 rounded-full mx-auto mb-12"></div>
      <p class="text-gray-400 font-light text-lg">Explora la colección y encuentra el diseño perfecto para acompañar tu selección.</p>
    </div>
  </div>
</Layout>

<script>
  // Script para la galería de imágenes del producto
  document.addEventListener('astro:page-load', () => {
    const mainImage = document.getElementById('main-product-image') as HTMLImageElement;
    const thumbnails = document.querySelectorAll('.thumbnail-btn');

    if (mainImage && thumbnails.length > 0) {
      thumbnails.forEach(btn => {
        btn.addEventListener('click', () => {
          const newSrc = btn.getAttribute('data-img');
          if (newSrc && mainImage.src !== newSrc) {
            // Animación suave de transición
            mainImage.style.opacity = '0.5';
            
            setTimeout(() => {
              mainImage.src = newSrc;
              mainImage.style.opacity = '1';
            }, 150);

            // Actualizar estados visuales de las miniaturas
            thumbnails.forEach(t => {
              t.classList.remove('border-gold-500', 'shadow-[0_0_15px_rgba(212,175,55,0.3)]', 'active-thumb', 'opacity-100');
              t.classList.add('border-white/5', 'opacity-70');
            });

            // Activar el botón clicado
            btn.classList.remove('border-white/5', 'opacity-70');
            btn.classList.add('border-gold-500', 'shadow-[0_0_15px_rgba(212,175,55,0.3)]', 'active-thumb', 'opacity-100');
          }
        });
      });
    }
  });
</script>
